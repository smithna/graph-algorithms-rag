# ── Neo4j ─────────────────────────────────────────────────────────────────────
# Point this at the DBMS holding the Lewis & Clark graph
# (restored from the corps-of-discovery-graph-rag dump).
# Requires the GDS plugin — PageRank, Louvain, and Yen's all run there.
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here
NEO4J_DATABASE=neo4j

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Only used to embed the *question*. Chunk and entity embeddings already
# live in the graph — this repo never re-embeds the corpus.
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Projection tuning (optional) ──────────────────────────────────────────────
# Name of the in-memory GDS graph created by scripts/project_graph.py
GRAPH_NAME=lc-retrieval
# Relative pull of sequence and entity-entity edges against IDF-weighted mentions
NEXT_CHUNK_WEIGHT=1.0
RELATED_WEIGHT=1.0
